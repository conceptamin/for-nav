# cp .env.example .env 뒤 값을 고치고 `uv run --env-file .env fastapi dev app/main.py`로 띄운다.
# 비워 두면(변수를 지우면) 아래 기본값을 쓴다.

# 센터 운영 시간(평일). HH:00-HH:00, 시 단위만 받는다
CENTER_HOURS=09:00-18:00
# 제도 정보 기준일(YYYY-MM-DD)
INFO_DATE=2026-10-24
# 허용 출처(쉼표 구분). 프론트는 Vite 프록시로 같은 출처에서 부르므로 개발 서버만 연다
CORS_ORIGINS=http://localhost:5180

# LLM(추출·템플릿 슬롯·번역). LLM_API_KEY를 비우면 LLM 자리를 건너뛰고 지금 템플릿·규칙으로 동작한다
# 공급자. anthropic만 지원한다
LLM_PROVIDER=anthropic
# 모델 이름
LLM_MODEL=claude-haiku-5-5
# API 키. .env에만 넣고 커밋하지 않는다
LLM_API_KEY=
# 호출 한 번의 시간 제한(초)
LLM_TIMEOUT_S=10
# 총 시도 횟수(첫 호출 + 재시도). 모두 실패하면 템플릿·규칙으로 돌아간다
LLM_ATTEMPTS=2
# 호출 제한(backlog 20). 공급자 호출 한 번(재시도 포함)을 하나로 센다. 0이면 끈다. 넘으면 LLM 없이 키워드·템플릿·원문으로 응답한다
# 맥미니는 deploy/ecosystem.config.cjs가 켠 값(60, 3000, cf-connecting-ip)을 넣는다
# 클라이언트 IP별 최근 60초 호출 수
LLM_RATE_PER_MIN=0
# 서버 전체 하루(Asia/Seoul) 호출 수. 서버를 다시 띄우면 0부터 센다
LLM_DAILY_LIMIT=0
# 클라이언트 IP 헤더(예: cf-connecting-ip). TCP 상대가 127.0.0.1·::1(같은 기기의 터널)일 때만 믿는다. 비우면 상대 주소
LLM_CLIENT_IP_HEADER=

# 센터 사례 SQLite 파일. 비우면 메모리 저장소(재시작하면 mock 시드 상태로 돌아간다). 연락처·자유 입력이 평문으로 남는다
DB_PATH=

# 프론트 빌드 폴더(npm --prefix ../frontend run build의 결과). 있으면 서버 하나에서 화면과 API를 같은 주소로 서빙한다
STATIC_DIR=

# 응급도·진료과 모델 폴더(modeling/models). 비우면 모델 없이 규칙·보조 점수로 동작한다
MODEL_DIR=

# 센터 직원 로그인(backlog 17). off면 센터 화면이 로그인 없이 열린다. email이면 DB_PATH가 있어야 한다
CENTER_AUTH=off
# 로그인 코드 메일. resend 또는 console(로컬 개발 전용: 코드를 서버 출력에 찍는다, CENTER_COOKIE_SECURE=false일 때만)
MAIL_PROVIDER=resend
# Resend API 키. .env에만 넣고 커밋하지 않는다
MAIL_API_KEY=
# 보내는 사람(Resend에서 인증한 도메인), 예: for-nav 센터 <no-reply@for-nav.com>
MAIL_FROM=
# 직원 세션 길이(일)
CENTER_SESSION_DAYS=30
# 세션 쿠키 Secure. 로컬 http 개발에서만 false
CENTER_COOKIE_SECURE=true

# 근로자 Google 로그인(backlog 21). off면 근로자 화면은 데모 로그인이다. google이면 DB_PATH와 GOOGLE_CLIENT_ID가 있어야 한다
WORKER_AUTH=off
# Google OAuth 웹 클라이언트 ID(비밀값 아님). deploy.sh가 이 값을 프론트·앱용 웹 빌드에 VITE_GOOGLE_CLIENT_ID로 넣는다
GOOGLE_CLIENT_ID=
# 근로자 세션 길이(일). 쿠키 Secure는 CENTER_COOKIE_SECURE를 따른다
WORKER_SESSION_DAYS=30
